<?xml version="1.0" encoding="UTF-8"?>
<interface domain="vibemapp">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="KmlHeatmapPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="window_title">
                <property name="title" translatable="yes">Heatmap</property>
              </object>
            </property>
            <child type="end">
              <object class="GtkButton" id="reset_button">
                <property name="icon-name">user-trash-symbolic</property>
                <property name="tooltip-text" translatable="yes">Reset Heatmap…</property>
                <property name="action-name">win.reset-heatmap</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="pause_button">
                <property name="icon-name">media-playback-pause-symbolic</property>
                <property name="tooltip-text" translatable="yes">Pause Recording</property>
                <property name="action-name">win.toggle-heatmap-recording</property>
              </object>
            </child>
          </object>
        </child>
        <child type="top">
          <object class="AdwBanner" id="paused_banner">
            <property name="title" translatable="yes">Recording is paused</property>
            <property name="button-label" translatable="yes">_Resume</property>
            <property name="action-name">win.toggle-heatmap-recording</property>
          </object>
        </child>
        <property name="content">
          <object class="GtkStack" id="stack">
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">no-keyboard</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="icon-name">input-keyboard-symbolic</property>
                    <property name="title" translatable="yes">No Keyboard Layout</property>
                    <property name="description" translatable="yes">Connect your keyboard to see which keys you use most</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">opt-in</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="icon-name">vibemapp-heatmap-symbolic</property>
                    <property name="title" translatable="yes">See Which Keys You Use</property>
                    <property name="description" translatable="yes">Vibemapp can count how often you press each key, per layer, to show a heatmap of your layout.

Only per-key press counts and the focused app's name are stored, never window titles or what you type. Counts stay on this computer.</property>
                    <property name="child">
                      <object class="GtkButton" id="start_button">
                        <property name="label" translatable="yes">_Start Recording</property>
                        <property name="use-underline">True</property>
                        <property name="halign">center</property>
                        <property name="action-name">win.toggle-heatmap-recording</property>
                        <style>
                          <class name="pill"/>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">heatmap</property>
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">18</property>
                        <property name="margin-top">18</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">18</property>
                        <property name="margin-end">18</property>
                        <child>
                          <object class="AdwWrapBox" id="filter_box">
                            <property name="halign">center</property>
                            <property name="align">0.5</property>
                            <property name="child-spacing">12</property>
                            <property name="line-spacing">12</property>
                            <child>
                              <object class="AdwToggleGroup" id="period_group">
                                <property name="can-shrink">True</property>
                                <property name="active-name">week</property>
                                <accessibility>
                                  <property name="label" translatable="yes">Period</property>
                                </accessibility>
                                <child>
                                  <object class="AdwToggle">
                                    <property name="name">today</property>
                                    <property name="label" translatable="yes">Today</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwToggle">
                                    <property name="name">week</property>
                                    <property name="label" translatable="yes">7 Days</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwToggle">
                                    <property name="name">all</property>
                                    <property name="label" translatable="yes">All Time</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="layer_dropdown">
                                <property name="tooltip-text" translatable="yes">Layer</property>
                                <accessibility>
                                  <property name="label" translatable="yes">Layer</property>
                                </accessibility>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="app_dropdown">
                                <property name="visible">False</property>
                                <property name="tooltip-text" translatable="yes">App</property>
                                <accessibility>
                                  <property name="label" translatable="yes">App</property>
                                </accessibility>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="KmlKeyboardView" id="keyboard_view">
                            <property name="vexpand">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="KmlHeatLegend" id="legend">
                            <property name="halign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwClamp">
                            <property name="maximum-size">560</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">18</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">2</property>
                                    <child>
                                      <object class="GtkLabel" id="total_label">
                                        <property name="selectable">True</property>
                                        <style>
                                          <class name="title-1"/>
                                          <class name="numeric"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="total_caption">
                                        <style>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwPreferencesGroup" id="top_group">
                                    <property name="title" translatable="yes">Top Keys</property>
                                    <child>
                                      <object class="GtkListBox" id="top_list">
                                        <property name="selection-mode">none</property>
                                        <accessibility>
                                          <property name="label" translatable="yes">Top keys</property>
                                        </accessibility>
                                        <style>
                                          <class name="boxed-list"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
