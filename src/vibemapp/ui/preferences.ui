<?xml version="1.0" encoding="UTF-8"?>
<interface domain="vibemapp">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="KmlPreferencesDialog" parent="AdwPreferencesDialog">
    <property name="search-enabled">False</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">General</property>
        <property name="icon-name">emblem-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Background</property>
            <child>
              <object class="AdwSwitchRow" id="tray_row">
                <property name="title" translatable="yes">Show in _Tray</property>
                <property name="use-underline">True</property>
                <property name="subtitle" translatable="yes">Closing the window keeps Vibemapp running in the tray</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="background_row">
                <property name="title" translatable="yes">Run in _Background</property>
                <property name="use-underline">True</property>
                <property name="subtitle" translatable="yes">Keep Smart Layers working after the window is closed, even without a tray</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Smart Layers</property>
            <child>
              <object class="AdwSwitchRow" id="notify_layer_row">
                <property name="title" translatable="yes">_Notify on Layer Changes</property>
                <property name="use-underline">True</property>
                <property name="subtitle" translatable="yes">Show a notification when Smart Layers switches the layer</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Startup</property>
            <child>
              <object class="AdwSwitchRow" id="smart_layers_row">
                <property name="title" translatable="yes">Enable _Smart Layers on Startup</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="auto_connect_row">
                <property name="title" translatable="yes">_Connect Automatically</property>
                <property name="use-underline">True</property>
                <property name="subtitle" translatable="yes">Connect to the keyboard as soon as it is plugged in</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Start With Hyprland</property>
            <property name="description" translatable="yes">To start in the background when you log in, add this to ~/.config/hypr/autostart.lua (or any file required from hyprland.lua)</property>
            <child>
              <object class="GtkOverlay">
                <property name="child">
                  <object class="GtkBox">
                    <style>
                      <class name="card"/>
                    </style>
                    <child>
                      <object class="GtkLabel" id="snippet_label">
                        <property name="selectable">True</property>
                        <property name="hexpand">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="wrap-mode">char</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">48</property>
                        <accessibility>
                          <property name="label" translatable="yes">Hyprland autostart snippet</property>
                        </accessibility>
                        <style>
                          <class name="monospace"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
                <child type="overlay">
                  <object class="GtkButton">
                    <property name="icon-name">edit-copy-symbolic</property>
                    <property name="halign">end</property>
                    <property name="valign">start</property>
                    <property name="margin-top">6</property>
                    <property name="margin-end">6</property>
                    <property name="tooltip-text" translatable="yes">Copy</property>
                    <signal name="clicked" handler="on_copy_clicked"/>
                    <accessibility>
                      <property name="label" translatable="yes">Copy the Hyprland autostart snippet</property>
                    </accessibility>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
