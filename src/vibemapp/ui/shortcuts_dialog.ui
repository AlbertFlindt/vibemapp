<?xml version="1.0" encoding="UTF-8"?>
<interface domain="vibemapp">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <object class="AdwShortcutsDialog" id="shortcuts_dialog">
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">General</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Show Layout</property>
            <property name="accelerator">&lt;Ctrl&gt;1</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Show Smart Layers</property>
            <property name="accelerator">&lt;Ctrl&gt;2</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Show Heatmap</property>
            <property name="accelerator">&lt;Ctrl&gt;3</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Show Overlay</property>
            <property name="accelerator">&lt;Ctrl&gt;4</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Show Insights</property>
            <property name="accelerator">&lt;Ctrl&gt;5</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Keyboard Information</property>
            <property name="accelerator">&lt;Ctrl&gt;i</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Preferences</property>
            <property name="accelerator">&lt;Ctrl&gt;comma</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Keyboard Shortcuts</property>
            <property name="accelerator">&lt;Ctrl&gt;question</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Close Window</property>
            <property name="accelerator">&lt;Ctrl&gt;w</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Quit</property>
            <property name="accelerator">&lt;Ctrl&gt;q</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Layout</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Previous Layer</property>
            <property name="accelerator">&lt;Ctrl&gt;Page_Up</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Next Layer</property>
            <property name="accelerator">&lt;Ctrl&gt;Page_Down</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Switch Keyboard to Shown Layer</property>
            <property name="accelerator">&lt;Ctrl&gt;Return</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Smart Layers</property>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Add Rule</property>
            <property name="accelerator">&lt;Ctrl&gt;n</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Move Rule Up</property>
            <property name="accelerator">&lt;Alt&gt;Up</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Move Rule Down</property>
            <property name="accelerator">&lt;Alt&gt;Down</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Remove Rule</property>
            <property name="accelerator">Delete</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes">Rule Menu</property>
            <property name="accelerator">&lt;Shift&gt;F10</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
