<?xml version="1.0" encoding="UTF-8"?>
<interface domain="vibemapp">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="KmlSmartLayersPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Smart Layers</property>
              </object>
            </property>
          </object>
        </child>
        <child type="top">
          <object class="AdwBanner" id="banner">
            <property name="title" translatable="yes">Smart Layers requires Hyprland</property>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage" id="prefs_page">
            <property name="description" translatable="yes">Switch your keyboard to a layer automatically when you focus an app</property>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwSwitchRow" id="enable_row">
                    <property name="title" translatable="yes">Smart Layers</property>
                    <property name="subtitle" translatable="yes">Switch layers when the focused app changes</property>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="status_row">
                    <property name="title" translatable="yes">No Focused App</property>
                    <property name="use-markup">False</property>
                    <property name="subtitle-lines">1</property>
                    <child type="prefix">
                      <object class="GtkImage" id="status_icon">
                        <property name="icon-name">focus-windows-symbolic</property>
                        <property name="pixel-size">32</property>
                        <property name="accessible-role">presentation</property>
                      </object>
                    </child>
                    <child type="suffix">
                      <object class="GtkLabel" id="status_target">
                        <property name="xalign">1</property>
                        <style>
                          <class name="status-target"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="rules_group">
                <property name="title" translatable="yes">Rules</property>
                <property name="description" translatable="yes">The first enabled rule that matches the focused window is used. Drag rules to change their order.</property>
                <property name="header-suffix">
                  <object class="GtkButton" id="add_button">
                    <property name="action-name">win.add-rule</property>
                    <property name="valign">center</property>
                    <property name="child">
                      <object class="AdwButtonContent">
                        <property name="icon-name">list-add-symbolic</property>
                        <property name="label" translatable="yes">_Add Rule</property>
                        <property name="use-underline">True</property>
                      </object>
                    </property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </property>
                <child>
                  <object class="GtkListBox" id="rules_list">
                    <property name="selection-mode">none</property>
                    <accessibility>
                      <property name="label" translatable="yes">Rules</property>
                    </accessibility>
                    <style>
                      <class name="boxed-list"/>
                      <class name="rules-list"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="fallback_group">
                <child>
                  <object class="AdwComboRow" id="fallback_row">
                    <property name="title" translatable="yes">Fallback Layer</property>
                    <property name="subtitle" translatable="yes">Used when no rule matches the focused window</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
