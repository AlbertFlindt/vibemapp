<?xml version="1.0" encoding="UTF-8"?>
<interface domain="vibemapp">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="KmlPointerPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="window_title">
                <property name="title" translatable="yes">Trackpad &amp; Trackball</property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="GtkStack" id="stack">
            <child>
              <object class="GtkStackPage">
                <property name="name">settings</property>
                <property name="child">
                  <object class="AdwPreferencesPage" id="prefs_page">
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="GtkBox" id="live_box">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <style>
                              <class name="card"/>
                            </style>
                            <child>
                              <object class="KmlPointerView" id="live_view">
                                <property name="halign">center</property>
                                <property name="margin-top">24</property>
                                <property name="width-request">200</property>
                                <property name="height-request">200</property>
                              </object>
                            </child>
                            <child>
                              <!-- Always as tall as its tallest text: the hidden probe holds
                                   the arrows, which come from a taller fallback font, so the
                                   card never changes height with the gesture. -->
                              <object class="GtkStack" id="live_caption">
                                <property name="vhomogeneous">True</property>
                                <property name="hhomogeneous">False</property>
                                <property name="margin-bottom">20</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>
                                <child>
                                  <object class="GtkLabel" id="live_label">
                                    <property name="label" translatable="yes">Touch the trackpad to try it</property>
                                    <property name="single-line-mode">True</property>
                                    <property name="ellipsize">end</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="live_probe">
                                    <property name="label">Ag ↑↓←→ …</property>
                                    <property name="single-line-mode">True</property>
                                    <property name="ellipsize">end</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">On-Screen Activity</property>
                        <child>
                          <object class="AdwSwitchRow" id="pill_row">
                            <property name="title" translatable="yes">Show Pointer _Activity</property>
                            <property name="use-underline">True</property>
                            <property name="subtitle" translatable="yes">Briefly draw what your fingers do, where held modifiers show, such as Ctrl and a scroll for zooming. Works without the overlay.</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwExpanderRow" id="actions_row">
                            <property name="title" translatable="yes">_Show For</property>
                            <property name="use-underline">True</property>
                            <property name="subtitle" translatable="yes">What makes it appear</property>
                            <property name="sensitive" bind-source="pill_row" bind-property="active" bind-flags="sync-create"/>
                            <child>
                              <object class="AdwSwitchRow" id="click_row">
                                <property name="title" translatable="yes">_Clicks</property>
                                <property name="use-underline">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="tap_row">
                                <property name="title" translatable="yes">_Taps</property>
                                <property name="use-underline">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="scroll_row">
                                <property name="title" translatable="yes">Sc_rolling</property>
                                <property name="use-underline">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="move_row">
                                <property name="title" translatable="yes">_Movement</property>
                                <property name="use-underline">True</property>
                                <property name="subtitle" translatable="yes">Moving the pointer or touching the trackpad</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="linger_row">
                            <property name="title" translatable="yes">Stay _Visible</property>
                            <property name="use-underline">True</property>
                            <property name="subtitle" translatable="yes">Milliseconds it stays after you stop, or 0 to hide it at once</property>
                            <property name="sensitive" bind-source="pill_row" bind-property="active" bind-flags="sync-create"/>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">5000</property>
                                <property name="step-increment">50</property>
                                <property name="page-increment">100</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="fade_row">
                            <property name="title" translatable="yes">_Fade Duration</property>
                            <property name="use-underline">True</property>
                            <property name="subtitle" translatable="yes">Milliseconds to fade in, or 0 to show it at once</property>
                            <property name="sensitive" bind-source="pill_row" bind-property="active" bind-flags="sync-create"/>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">1000</property>
                                <property name="step-increment">50</property>
                                <property name="page-increment">100</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Overlay</property>
                        <property name="description" translatable="yes">Position, monitor, size and opacity are set on the Overlay page. A layer the keyboard turns on when you touch the trackpad, such as a Mouse layer, is chosen there too.</property>
                        <child>
                          <object class="AdwSwitchRow" id="overlay_row">
                            <property name="title" translatable="yes">Show on _Overlay</property>
                            <property name="use-underline">True</property>
                            <property name="subtitle" translatable="yes">Draw it beside the keys while the overlay is shown. It never makes the overlay appear on its own.</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwComboRow" id="side_row">
                            <property name="title" translatable="yes">_Side</property>
                            <property name="use-underline">True</property>
                            <property name="subtitle" translatable="yes">Which half the trackpad or trackball is mounted on</property>
                            <property name="sensitive" bind-source="overlay_row" bind-property="active" bind-flags="sync-create"/>
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">Right</item>
                                  <item translatable="yes">Left</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">none</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="icon-name">input-touchpad-symbolic</property>
                    <property name="title" translatable="yes">No Trackpad or Trackball</property>
                    <property name="description" translatable="yes">This keyboard has no trackpad or trackball. A trackball shows up after it first moves.</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">unavailable</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="icon-name">video-display-symbolic</property>
                    <property name="title" translatable="yes">Overlay Unavailable</property>
                    <property name="description" translatable="yes">Showing pointer activity on screen needs the gtk4-layer-shell package, like the overlay. The rest of Vibemapp works without it.

Install it, then restart Vibemapp.</property>
                    <property name="child">
                      <object class="AdwClamp">
                        <property name="maximum-size">400</property>
                        <property name="child">
                          <object class="GtkOverlay">
                            <property name="child">
                              <object class="GtkBox">
                                <style>
                                  <class name="card"/>
                                </style>
                                <child>
                                  <object class="GtkLabel" id="install_label">
                                    <property name="hexpand">True</property>
                                    <property name="xalign">0</property>
                                    <property name="wrap">True</property>
                                    <property name="wrap-mode">char</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">48</property>
                                    <accessibility>
                                      <property name="label" translatable="yes">Install command</property>
                                    </accessibility>
                                    <style>
                                      <class name="monospace"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                            <child type="overlay">
                              <object class="GtkButton">
                                <property name="icon-name">edit-copy-symbolic</property>
                                <property name="halign">end</property>
                                <property name="valign">start</property>
                                <property name="margin-top">6</property>
                                <property name="margin-end">6</property>
                                <property name="tooltip-text" translatable="yes">Copy</property>
                                <signal name="clicked" handler="on_copy_install_clicked"/>
                                <accessibility>
                                  <property name="label" translatable="yes">Copy the install command</property>
                                </accessibility>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
