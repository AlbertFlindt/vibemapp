<?xml version="1.0" encoding="UTF-8"?>
<interface domain="vibemapp">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="KmlDeviceDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Keyboard Information</property>
    <property name="content-width">420</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">input-keyboard-symbolic</property>
                        <property name="pixel-size">64</property>
                        <property name="margin-bottom">6</property>
                        <property name="accessible-role">presentation</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="name_label">
                        <property name="wrap">True</property>
                        <property name="justify">center</property>
                        <style>
                          <class name="title-1"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="state_label">
                        <property name="wrap">True</property>
                        <property name="justify">center</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="info_group"/>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="oryx_group">
                <child>
                  <object class="AdwActionRow" id="oryx_row">
                    <property name="title" translatable="yes">_Open in Oryx</property>
                    <property name="use-underline">True</property>
                    <property name="activatable">True</property>
                    <property name="subtitle">configure.zsa.io</property>
                    <signal name="activated" handler="on_oryx_activated"/>
                    <child type="suffix">
                      <object class="GtkImage">
                        <property name="icon-name">adw-external-link-symbolic</property>
                        <property name="accessible-role">presentation</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwButtonRow" id="reload_row">
                    <property name="title" translatable="yes">_Reload Layout</property>
                    <property name="use-underline">True</property>
                    <property name="start-icon-name">view-refresh-symbolic</property>
                    <signal name="activated" handler="on_reload_activated"/>
                  </object>
                </child>
                <child>
                  <object class="AdwButtonRow" id="disconnect_row">
                    <property name="title" translatable="yes">_Disconnect</property>
                    <property name="use-underline">True</property>
                    <signal name="activated" handler="on_disconnect_activated"/>
                    <style>
                      <class name="destructive-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
