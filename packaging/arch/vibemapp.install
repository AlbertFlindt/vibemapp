post_install() {
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --subsystem-match=hidraw 2>/dev/null || true
  echo ">> Replug your ZSA keyboard so the new udev rules apply."
  echo ">> To start Vibemapp with Hyprland, add to ~/.config/hypr/autostart.lua:"
  echo '>>     hl.on("hyprland.start", function ()'
  echo '>>       hl.exec_cmd("vibemapp --background")'
  echo '>>     end)'
}
post_upgrade() { post_install; }
