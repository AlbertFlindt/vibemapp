<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.albertflindt.KeyMappForLinux</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>KeyMapp for Linux</name>
  <summary>See your ZSA keyboard layout and switch layers per app</summary>
  <developer id="io.github.albertflindt">
    <name>Albert Flindt</name>
  </developer>
  <description>
    <p>
      KeyMapp for Linux is a companion app for ZSA keyboards running Oryx firmware,
      such as the Voyager, Moonlander and ErgoDox EZ.
    </p>
    <ul>
      <li>Smart Layers: switch the keyboard to a layer automatically when you focus an app</li>
      <li>Optional window title patterns for finer-grained rules</li>
      <li>See every layer of your Oryx layout, following the keyboard live</li>
      <li>Watch key presses as you type</li>
      <li>Runs quietly in the background</li>
    </ul>
    <p>
      Smart Layers currently requires the Hyprland compositor.
    </p>
  </description>
  <launchable type="desktop-id">io.github.albertflindt.KeyMappForLinux.desktop</launchable>
  <url type="homepage">https://github.com/albertflindt/keyMappForLinux</url>
  <url type="bugtracker">https://github.com/albertflindt/keyMappForLinux/issues</url>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <provides>
    <binary>keymappforlinux</binary>
  </provides>
  <keywords>
    <keyword>keyboard</keyword>
    <keyword>ZSA</keyword>
    <keyword>Oryx</keyword>
    <keyword>layer</keyword>
  </keywords>
  <releases>
    <release version="0.1.0" date="2026-10-09">
      <description>
        <p>First release, with Smart Layers for Hyprland and a live layout viewer.</p>
      </description>
    </release>
  </releases>
</component>
