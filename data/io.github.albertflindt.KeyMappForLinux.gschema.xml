<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="keymappforlinux">
  <schema id="io.github.albertflindt.KeyMappForLinux" path="/io/github/albertflindt/KeyMappForLinux/">
    <key name="run-in-background" type="b">
      <default>false</default>
      <summary>Run in background</summary>
      <description>Keep the app and Smart Layers running after the window is closed.</description>
    </key>
    <key name="smart-layers-on-startup" type="b">
      <default>true</default>
      <summary>Enable Smart Layers on startup</summary>
      <description>Turn on automatic layer switching when the app starts.</description>
    </key>
    <key name="auto-connect" type="b">
      <default>true</default>
      <summary>Connect automatically</summary>
      <description>Connect to a supported keyboard as soon as it is plugged in.</description>
    </key>
    <key name="window-width" type="i">
      <default>960</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>660</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="last-page" type="s">
      <choices>
        <choice value="layout"/>
        <choice value="smart-layers"/>
      </choices>
      <default>"layout"</default>
      <summary>Last visible page</summary>
    </key>
  </schema>
</schemalist>
